# ===========================================
# 로컬 Docker MySQL + Spring Boot (복사 후 .env 로 저장)
# cp .env.example .env
# ===========================================

# --- Docker Compose (mysql 서비스) ---
# compose가 컨테이너 생성 시 사용합니다. 프로젝트 루트에 .env 가 있으면 자동 로드됩니다.
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=feedshop_db
MYSQL_USER=feedshop
MYSQL_PASSWORD=change-me-app

# --- Spring Boot (application.properties 와 동일 키) ---
# DB 계정은 Docker의 MYSQL_USER / MYSQL_PASSWORD 와 반드시 같게 맞추세요.
DB_HOST=localhost
DB_NAME=feedshop_db
DB_USERNAME=feedshop
DB_PASSWORD=change-me-app

# 앱 기동에 필요 (로컬 개발용 예시 — 운영 값 사용 금지)
JWT_SECRET=change-me-jwt-at-least-256-bits-recommended-for-dev-only
